{
  "name": "kyestu",
  "version": "0.0.1",
  "description": "SNS 聚合转发系统（X/IG/TikTok/YT/官网 → QQ/B站），基于时空可组合 runtime（可回滚 effect + 反应式 coeffect + fiber 生命周期）",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "import": "bun scripts/import-idol-bbq.ts",
    "test": "bun test",
    "smoke": "bun test tests/shortcircuit.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "bun-types": "^1.2.0"
  },
  "dependencies": {
    "@kyestu/log": "workspace:*",
    "@kyestu/render": "workspace:*",
    "@kyestu/spider": "workspace:*",
    "@puppeteer/browsers": "3.2.0",
    "puppeteer-core": "^25.7.0",
    "yaml": "^2.9.0"
  }
}
